DEEPSEEK_API_KEY=your_deepseek_api_key
LARK_APP_ID=your_lark_app_id
LARK_SECRET=your_lark_secret
LARK_RECEIVER=your_union_id
# Optional Langfuse tracing (omit both keys to disable)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Cloud doc folder token — see docs/lark-doc.md
LARK_FOLDER_TOKEN=your_lark_folder_token
# Optional: enterprise Feishu domain (default feishu.cn)
# LARK_DOC_DOMAIN=feishu.cn
